@@ -471,0 +472,12 @@ impl UnqualifiedObservation<'_> {
+// Extract the existing check-before-slow-work ordering for an independent
+// deterministic regression. This RED patch deliberately preserves the bug.
+fn finish_observation(
+    process: &ObservedProcess,
+    verify: impl FnOnce() -> io::Result<()>,
+) -> io::Result<()> {
+    if !process.is_alive()? {
+        return Err(denied("candidate process exited"));
+    }
+    verify()
+}
