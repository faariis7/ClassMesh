@@ -298,0 +299,30 @@ fn scm_absence_is_an_error_without_registration_or_fallback() {
+#[test]
+fn identity_evidence_race_exit_during_final_sample_is_rejected() {
+    let mut child = spawn_child();
+    let process = ObservedProcess::open(child.0.id()).unwrap();
+    let result = finish_observation(&process, || {
+        child.0.kill().unwrap();
+        wait_child(&mut child);
+        Ok(())
+    });
+    assert!(
+        result.is_err(),
+        "IDENTITY_EVIDENCE_RACE: exited process accepted after final sample"
+    );
+}
+
+#[test]
+fn identity_evidence_race_original_image_error_is_preserved() {
+    let mut child = spawn_child();
+    let process = ObservedProcess::open(child.0.id()).unwrap();
+    let result = finish_observation(&process, || {
+        child.0.kill().unwrap();
+        wait_child(&mut child);
+        Err(io::Error::other("original image observation failure"))
+    });
+    assert_eq!(
+        result.unwrap_err().to_string(),
+        "original image observation failure"
+    );
+}
