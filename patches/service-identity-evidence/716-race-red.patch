+fn finish_observation(
+    process: &ObservedProcess,
+    verify: impl FnOnce() -> io::Result<()>,
+) -> io::Result<()> {
+    if !process.is_alive()? {
+        return Err(denied("candidate process exited"));
+    }
+    verify()
